; The Windows 98 driver package: what infgen writes into the INF, which goes
; into the package folder with the eight files it names. The PCI identity comes
; from vgpu98.card and the desktop modes from display-modes.card. Format:
; spec/card-definition.md

[driver]
provider       = "VGPU98 Project"
device         = "VGPU98 2000"            ; the name Device Manager shows
disk_name      = "VGPU98 2000 Driver Disk"
disk_label     = VGPU98                   ; a floppy image's volume label (mkdisk; not built)
display_driver = vgpu98.drv               ; 16-bit DIB engine minidriver
minivdd        = vgpu98.vxd               ; mini-VDD
directx_driver = vgpu98dx.dll             ; DirectDraw and Direct3D (driver32/)
glide2_driver  = glide2x.dll              ; Glide 2.x (glide/glide2x/), the name Glide 2 programs load
glide3_driver  = glide3x.dll              ; Glide 3.x (glide/glide3x/), the name Glide 3 programs load
opengl_driver  = vgpu98gl.dll             ; the OpenGL ICD (opengl/), which opengl32.dll loads by the name below
opengl_name    = VGPU98                   ; the ICD's name: the display driver's OPENGL_GETINFO answers it (driver/ddraw.asm)
control_panel  = vgpu98cp.cpl             ; the control program (cpl/): the Advanced dialog's tab, the Control Panel's icon
control_clsid  = {79D3DDE2-6AC4-43A5-860C-5C7E56C689F2} ; its tab's class, as DllGetClassObject answers it (cpl/main.c)
inf            = vgpu98.inf
version        = 4.10.0.1                 ; the INF's DriverVer (each file's own version information is in its link definition)
date           = 10/10/2026               ; DriverVer date, fixed so the INF is reproducible
default_mode   = 8 640 480                ; bits per pixel, width, height after installing
