; vglink test module (NE): what test_vglink expects is worked out in ne_a.asm.

[module]
format      = ne
name        = Display
description = "DISPLAY : 100, 96, 96 : vglink test"
entry       = Entry
data        = _DATA
heap        = 0x40

[segment _TEXT]
type = code

[segment _DATA]
type = data

[segment _INIT]
type    = code
preload = 0

[exports]
1   = Entry
2   = Exp2 nodata
5   = Exp5
400 = Exp400
700 = Exp700 resident

[imports DIBENG]
1 = ImpFar

[imports KERNEL]
175 = ImpSeg
18  = ImpOff

[resource oembin 1]
file = res1.bin

[resource OEMBIN fonts]
file = res2.bin

[version]
file_version         = 4.10.0.1
product_version      = 4.10.0.1
file_type            = 3
file_subtype         = 4
company              = "VGPU98 Project"
description          = "vglink test module"
file_version_text    = "4.10.0.1"
internal_name        = "TEST"
copyright            = "Copyright 2026 VGPU98 Project contributors"
original_name        = "TEST.DRV"
product_name         = "VGPU98 2000"
product_version_text = "4.10.0.1"
