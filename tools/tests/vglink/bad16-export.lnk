; vglink negative tests (NE): the definition most BAD_* objects link with.

[module]
format      = ne
name        = BAD
description = "vglink negative test"
data        = _DATA

[segment _TEXT]
type = code

[segment _DATA]
type = data

[exports]
1 = Entry
2 = NoSuchSymbol

[imports DIBENG]
1 = ImpFar
