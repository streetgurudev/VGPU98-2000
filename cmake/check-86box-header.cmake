# Compares a VGPU98 header (generated by cardc, or the command set) with its copy in the 86Box tree.
# Inputs: GENERATED, COMMITTED (file paths); REPO (the 86Box checkout) and
# REPO_PATH (the header's path inside it) for the commit check.
#
# The working copy must match: 86Box builds from it, so a mismatch is an error.
# The copy committed at HEAD should match too: a mismatch there means the
# header was updated but not committed, which is only a warning.
#
# Line endings are ignored: 86Box's checkout converts text files to CRLF on Windows.

set(fix "Run: cmake --build <build dir> --target update-86box-header, then commit the header on the 86Box vgpu98 branch.")

if(NOT EXISTS "${COMMITTED}")
    message(FATAL_ERROR "${COMMITTED} is missing. ${fix}")
endif()

file(READ "${GENERATED}" generated)
file(READ "${COMMITTED}" committed)
string(REPLACE "\r\n" "\n" generated "${generated}")
string(REPLACE "\r\n" "\n" committed "${committed}")
if(NOT generated STREQUAL committed)
    message(FATAL_ERROR "${COMMITTED} does not match ${GENERATED}. ${fix}")
endif()

if(REPO AND REPO_PATH)
    find_program(GIT_EXECUTABLE NAMES git)
    if(GIT_EXECUTABLE)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" show "HEAD:${REPO_PATH}"
            OUTPUT_VARIABLE at_head
            RESULT_VARIABLE result
            ERROR_QUIET)
        string(REPLACE "\r\n" "\n" at_head "${at_head}")
        if(NOT result EQUAL 0)
            message(WARNING "${REPO_PATH} is not committed in ${REPO}. Commit it on the vgpu98 branch.")
        elseif(NOT at_head STREQUAL generated)
            message(WARNING "${REPO_PATH} matches its source but differs from the commit at HEAD in ${REPO}. Commit it on the vgpu98 branch.")
        endif()
    endif()
endif()
