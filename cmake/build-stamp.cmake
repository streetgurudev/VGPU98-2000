# The build stamp: the commit the drivers are built from, for every line they
# write to the host's log (spec/registers.md).
#
#   cmake -DSOURCE=<source tree> -DOUT=<gen dir> [-DSTAMP=<stamp>] [-DTIME=<seconds>] -P build-stamp.cmake
#
# STAMP defaults to the short commit, with "-dirty" when tracked files have
# uncommitted changes (the 86Box submodule's commit aside: the drivers are
# this tree's alone), or "unknown" outside git; TIME (the commit's time, in
# seconds since 1970, for the package's ISO image) to the commit's, or 0. The
# release and the reproducibility check pass both, so builds of a copy of the
# tree outside git come out the same.
#
# Writes OUT/stamp.h (C), OUT/stamp.inc (NASM) and OUT/stamp.txt (the stamp
# and the time), each only when its content changes, so nothing is rebuilt
# for an unchanged stamp.

if(NOT DEFINED SOURCE OR NOT DEFINED OUT)
    message(FATAL_ERROR "usage: cmake -DSOURCE=<dir> -DOUT=<dir> [-DSTAMP=<stamp>] [-DTIME=<seconds>] -P build-stamp.cmake")
endif()

find_program(GIT_EXECUTABLE git PATHS "$ENV{ProgramFiles}/Git/cmd" "C:/Program Files/Git/cmd")

if(NOT STAMP)
    set(STAMP "unknown")
    if(GIT_EXECUTABLE AND EXISTS "${SOURCE}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" rev-parse --short=7 HEAD
                        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(rc EQUAL 0 AND commit)
            set(STAMP "${commit}")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" diff --quiet --ignore-submodules HEAD --
                            RESULT_VARIABLE dirty ERROR_QUIET)
            if(NOT dirty EQUAL 0)
                string(APPEND STAMP "-dirty")
            endif()
        endif()
    endif()
endif()

if(NOT TIME)
    set(TIME 0)
    if(GIT_EXECUTABLE AND EXISTS "${SOURCE}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" log -1 --format=%ct
                        OUTPUT_VARIABLE t OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(rc EQUAL 0 AND t MATCHES "^[0-9]+$")
            set(TIME "${t}")
        endif()
    endif()
endif()

if(NOT STAMP MATCHES "^[0-9A-Za-z._+-]+$")
    message(FATAL_ERROR "build stamp '${STAMP}': letters, digits and . _ + - only")
endif()
if(NOT TIME MATCHES "^[0-9]+$")
    message(FATAL_ERROR "build time '${TIME}': seconds since 1970")
endif()

function(write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" old)
        if(old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

write_if_changed("${OUT}/stamp.h" "/* Generated by cmake/build-stamp.cmake. */\n#define VGPU98_BUILD_STAMP \"${STAMP}\"\n")
write_if_changed("${OUT}/stamp.inc" "; Generated by cmake/build-stamp.cmake.\n%define BUILD_STAMP \"${STAMP}\"\n")
write_if_changed("${OUT}/stamp.txt" "${STAMP} ${TIME}\n")
